RAVELRY_USERNAME=
RAVELRY_PASSWORD=

# Anthropic (required for skeinminder recommend)
ANTHROPIC_API_KEY=
SKEINMINDER_MODEL=   # optional; defaults to claude-haiku-4-5-20251001

# Langfuse tracing (optional — set to enable graph tracing in Langfuse UI)
# Run `docker compose up -d` first, then copy the pre-seeded keys below.
# Pre-seeded local keys (from docker-compose.yml LANGFUSE_INIT_PROJECT_* vars):
LANGFUSE_PUBLIC_KEY=lf-pk-skeinminder-local
LANGFUSE_SECRET_KEY=lf-sk-skeinminder-local
LANGFUSE_HOST=http://localhost:3000
